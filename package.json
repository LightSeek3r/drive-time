{
  "name": "drive-time",
  "private": true,
  "type": "module",
  "version": "0.7.0",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit && tsc -p tsconfig.worker.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "icons": "node scripts/make-icons.mjs",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261113.1",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.6.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.2.1",
    "jsdom": "^23.0.1",
    "prettier": "^3.10.1",
    "sharp": "^0.35.5",
    "typescript": "^5.3.3",
    "vite": "^5.0.10",
    "vite-plugin-pwa": "^0.21.2",
    "vitest": "^1.1.0",
    "wrangler": "^4.161.0"
  }
}
